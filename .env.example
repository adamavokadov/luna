# Copy to .env and fill in. Real secrets never go to git (.env is ignored).
# In GitHub Codespaces, prefer repository/user Codespaces secrets: they arrive as environment
# variables and take priority over this file.

# --- Telegram ---
BOT_TOKEN=123456:replace-me           # from @BotFather
RUN_MODE=polling                      # polling | webhook
# WEBHOOK_BASE_URL=https://bot.example.com
# WEBHOOK_SECRET=change-me
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/skazki.db
# REDIS_URL=redis://localhost:6379/0  # FSM state in Redis (needed for several replicas)

# --- LLM ---
LLM_PROVIDER=anthropic                # anthropic | fake (offline: canned stories)
ANTHROPIC_API_KEY=sk-ant-replace-me
# LLM_MODEL=claude-sonnet-5-5
# GUARD_MODEL=claude-haiku-5-5
# LLM_EFFORT=medium                   # low | medium | high | xhigh | max (Claude 5.x thinks by default)
# LLM_THINKING=auto                   # auto | adaptive | between_tools (between_tools: Sonnet 5.5, up to high effort)
# GUARD_EFFORT=low
# LLM_STRICT_TOOLS=true               # strict tool use for the skill tools
# CRITIC_ENABLED=true

# --- Product limits ---
# DAILY_TALE_LIMIT=5
# MAX_CHILDREN_PER_USER=3
TIMEZONE=Europe/Moscow                # day boundary for limits and Luna's daytime window
# ADMIN_IDS=123456789,987654321       # no limits for these Telegram user ids

# --- Luna's warm words (users opt in; this is only the master switch and the schedule) ---
# CHEER_ENABLED=true
# CHEER_TICK_S=300
# CHEER_WINDOW_START=10               # local hour, inclusive
# CHEER_WINDOW_END=21                 # local hour, exclusive
# CHEER_BATCH_SIZE=40

# --- Logs ---
LOG_LEVEL=INFO
LOG_JSON=false
